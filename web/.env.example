# Auth.js
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=common

# Encrypts per-user connector credentials at rest.
APP_ENCRYPTION_KEY=replace-with-a-different-long-random-secret

# Local DB location (relative to web/ unless absolute)
REPORTFLOW_DB_PATH=./data/reportflow.sqlite

# Optional local UI preview before OAuth apps are configured.
# The application refuses to start with this enabled in production.
DEV_BYPASS_AUTH=false
REPORTFLOW_TEMPLATE_DIR=./data/templates

# Stage 4 cron/worker endpoint authentication. Generate a long random value.
REPORTFLOW_SCHEDULER_SECRET=replace-with-a-long-random-secret

# Stage 5 delivery OAuth. These may reuse the login OAuth app credentials, but separate apps are recommended for production.
REPORTFLOW_BASE_URL=http://localhost:3000
GOOGLE_DELIVERY_CLIENT_ID=
GOOGLE_DELIVERY_CLIENT_SECRET=
MICROSOFT_DELIVERY_CLIENT_ID=
MICROSOFT_DELIVERY_CLIENT_SECRET=
MICROSOFT_DELIVERY_TENANT_ID=common

# Generated reports are handed from the report worker to the delivery worker through this directory.
REPORTFLOW_GENERATED_DIR=./data/generated
# Optional explicit Python executable. By default ReportFlow uses ../.venv when it exists.
REPORTFLOW_PYTHON=

# Optional shared fallback for the AI assistant. Users can connect their own encrypted key in the UI.
OPENAI_API_KEY=
REPORTFLOW_AI_MODEL=gpt-5.6-terra
